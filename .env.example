# Discord Bot — https://discord.com/developers/applications
DISCORD_TOKEN=
CLIENT_ID=

# Discord OAuth2 — same application, OAuth2 tab
# Add redirect URI: https://your-app.onrender.com/auth/callback
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://your-app.onrender.com/auth/callback

# Session signing secret — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=

# TMDB API — https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Server
PORT=3000
# Public base URL of your Render deployment (no trailing slash)
PUBLIC_URL=https://your-app.onrender.com

# Supabase (optional — for persistent room state across Render restarts)
# https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=
SUPABASE_KEY=
