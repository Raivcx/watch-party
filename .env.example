# Discord Bot — https://discord.com/developers/applications
DISCORD_TOKEN=
CLIENT_ID=

# TMDB API — https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# TMDB-Embed-API — https://github.com/Inside4ndroid/TMDB-Embed-API
# Deploy that repo as a second Render Web Service, then paste its URL here (no trailing slash)
EMBED_API_URL=https://your-embed-api.onrender.com

# Server
PORT=3000
# Public base URL of your Render deployment (no trailing slash)
PUBLIC_URL=https://your-app.onrender.com
