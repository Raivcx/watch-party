# Discord application / bot
DISCORD_TOKEN=
CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Register this exact callback URL in the Discord Developer Portal
DISCORD_REDIRECT_URI=https://your-app.onrender.com/auth/discord/callback

# Generate a private random secret (for example: openssl rand -base64 48)
